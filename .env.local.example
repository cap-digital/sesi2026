# GA4 — property "SESI - Jequié Matrículas" (549923980)
# Credenciais da conta de serviço com acesso de leitura na property.
# Só o servidor lê estas variáveis: nunca use prefixo NEXT_PUBLIC_ aqui.
# Na Vercel, cadastre as três em Project Settings → Environment Variables.
GA4_PROPERTY_ID=549923980
GA4_CLIENT_EMAIL=xxx@xxx.iam.gserviceaccount.com
# a chave vai numa linha só, entre aspas, com \n literais
GA4_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
